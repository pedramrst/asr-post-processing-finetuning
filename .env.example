# Copy this file to .env and fill in a real token, then run everything from
# the repo root (so this file is found). Skip this entirely if you've already
# run `huggingface-cli login` on this machine -- that cached login is checked
# first and this is only a fallback for machines where you haven't.

# Needs read access to the gated ErfanRou/callcc-2k dataset and to any gated
# models you train on (e.g. google/gemma-3-1b-it, once your access request is
# approved). Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Only needed for `./run.sh agent` (the Telegram + LLM tool-calling
# operations agent -- see README's "Telegram agent" section). Get a key at
# https://openrouter.ai/keys -- routed through OpenRouter's universal
# OpenAI-compatible chat completions endpoint, so AGENT_MODEL below can be
# any tool-calling-capable model OpenRouter carries (not only Anthropic's --
# that's the whole point of using OpenAI-format tool calling here instead
# of Anthropic's own tool_runner, which only OpenRouter's Anthropic-specific
# endpoint supports).
OPENROUTER_API_KEY=
# Which model OpenRouter should route to, e.g. "anthropic/claude-opus-5",
# "openai/gpt-5", "google/gemini-3-pro". See https://openrouter.ai/models
# for the full list, current pricing, and which models support tool use.
AGENT_MODEL=anthropic/claude-opus-5
# Create a bot via @BotFather on Telegram (send it /newbot) to get a token.
TELEGRAM_BOT_TOKEN=
# Your own chat id -- the agent only responds to this one chat. Message your
# new bot once, then GET https://api.telegram.org/bot<token>/getUpdates and
# read the numeric "chat":{"id": ...} field from the response.
TELEGRAM_CHAT_ID=
